{
  "name": "wochenplaner-v-v",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WIR. – Familien- und Wochenplaner für ein Touchdisplay: Kalender, Wetter, Essensplan (glutenfrei), Wir-Zeit-Begleiter.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "server": "node server/server.mjs",
    "start": "npm run build && node server/server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
