# Nach /etc/wir-planer.env kopieren und anpassen (Datei nur für root lesbar machen: chmod 600).
WIR_PASSWORD=bitte-ein-eigenes-langes-passwort
PORT=8787
# Wo Datenstand und tägliche Sicherungen liegen
WIR_DATA=/home/pi/wir-daten
# Zeitzone für Erinnerungen und Kalender-Feed
WIR_TZ=Europe/Berlin
# Kontaktadresse für Push-Dienste (Google/Apple/Mozilla verlangen eine)
WIR_PUSH_CONTACT=mailto:eure@adresse.de
